rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada conta só lê e grava os próprios dados
    match /usuarios/{uid}/dados/{documento} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Fotos dos itens dos orçamentos (já reduzidas no navegador)
    match /usuarios/{uid}/imagens/{imagem} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.dados is string
        && request.resource.data.dados.size() < 900000;
    }
  }
}
